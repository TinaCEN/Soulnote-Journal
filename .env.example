# Soulnote Configuration File
# Copy this file to .env and fill in your API keys

# AI Provider Configuration
# Choose one: "deepseek", "openai", "anthropic", "mock", or "auto"
AI_PROVIDER=mock

# DeepSeek Configuration (Recommended - Fast and Affordable)
# Get your API key from: https://platform.deepseek.com/api_keys
# Free tier: $5 credit for new users, pay-as-you-go pricing (~$0.14/1M tokens)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI Configuration (if using OpenAI)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Anthropic Configuration (if using Anthropic Claude)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Server Configuration
SERVER_PORT=5001
DEBUG_MODE=False

# Audio Processing
MAX_AUDIO_LENGTH=300  # seconds
SUPPORTED_AUDIO_FORMATS=wav,mp3,webm,m4a

# Image Generation
POSTER_WIDTH=1080
POSTER_HEIGHT=1350
CARD_FORMATS=instagram,twitter,square
